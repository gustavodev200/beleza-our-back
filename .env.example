# Copie para .env e preencha. Nunca commite o .env.
NODE_ENV=development
PORT=3333

# Postgres (docker compose: usuário da aplicação, sem superusuário)
DATABASE_URL="postgresql://belezaour:belezaour@localhost:5433/belezaour?schema=public"

# Better Auth — gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Em produção, use a origem pública do front: ele repassa /api para esta API (mesma origem
# para o cookie de sessão e para os links de verificação/redefinição de senha).
BETTER_AUTH_URL=http://localhost:3333

# Front-end (links de e-mail) e origens permitidas no CORS (separadas por vírgula)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Resend (vazio em dev: e-mails só registrados em log)
RESEND_API_KEY=
EMAIL_FROM="belezaOur <nao-responda@belezaour.app>"

# Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Admin criado pelo seed (senha forte, mínimo 12 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Swagger em /api/docs (nunca true em produção)
SWAGGER_ENABLED=true

# Número de proxies reversos à frente da API (0 em dev). Com o front Next repassando /api,
# coloque um proxy reverso (Nginx/Caddy/LB) na frente do Next que sobrescreva/anexe
# X-Forwarded-For e use 1 — o Next não anexa hop e repassaria um valor forjado pelo cliente.
TRUST_PROXY_HOPS=0

# Web Push (notificações do PWA). Gere o par com: npx web-push generate-vapid-keys
# A pública vai para o navegador via GET /api/push/public-key (o front não precisa de env).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@belezaour.app

# Cron externo: POST /api/internal/cron/tick com "Authorization: Bearer <CRON_SECRET>"
# a cada minuto (ex.: cron-job.org). Mantém lembretes de 15 min e "na hora" pontuais
# mesmo quando a hospedagem gratuita põe a API para dormir. Gere com: openssl rand -hex 32
CRON_SECRET=
# Agendador interno (ms). Padrão 60000.
# SCHEDULER_INTERVAL_MS=60000
